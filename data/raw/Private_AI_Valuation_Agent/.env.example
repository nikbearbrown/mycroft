# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Supabase Postgres ---
# Project Settings -> Database -> Connection string -> URI
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_DB_PASSWORD=

# --- SEC EDGAR identity ---
# The SEC REQUIRES a declared User-Agent with a real name and email.
# Requests without one return HTTP 403. Verified empirically.
EDGAR_NAME=Your Name
EDGAR_EMAIL=you@example.edu

# --- Groq (quarterly commentary only, Week 11) ---
GROQ_API_KEY=

# --- Ollama (local entity-resolution adjudication, Week 5) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
