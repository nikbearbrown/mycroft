# Copy this file to `.env` and fill in your own values. Do not commit `.env`.

# LLM (added Week 7 — Groq is the default, Claude is the drop-in alternative)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (added Week 4; accessed via the supabase-py REST client)
# The dashboard/pull endpoint uses the ANON key (RLS: read-only). The service_role
# key is server-side ONLY (n8n Postgres credential) — never ship it to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SMTP for the email digest + pipeline-failure alert (Week 10)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO=
