# SEC requires a descriptive User-Agent with a contact. Set this before running.
# Format: "<name or app> <email>"
EDGAR_USER_AGENT=finance-event-signals you@example.com

# --- ingest-gateway ---
POLL_INTERVAL_SECONDS=60
EDGAR_FTS_FORMS=8-K
EDGAR_FTS_QUERY=
EDGAR_FTS_LOOKBACK_DAYS=1
EDGAR_ATOM_ENABLED=true
EDGAR_ATOM_FORMS=8-K
SEC_RATE_LIMIT_PER_SEC=5
DEDUP_TTL_SECONDS=604800

# --- validation-svc (GIGO gate) ---
# reject events whose published_at is older than this many days
FRESHNESS_DAYS=7

# --- enrichment-svc (LangGraph agent) ---
# deterministic (offline, default) | anthropic (needs ANTHROPIC_API_KEY)
LLM_PROVIDER=deterministic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ENRICH_SELF_CONSISTENCY_PASSES=2
ENRICH_CONF_THRESHOLD=0.5

# --- infra (compose sets these; override only if running a service outside compose) ---
KAFKA_BROKERS=redpanda:9092
REDIS_ADDR=redis:6379
POSTGRES_DSN=postgres://fes:fes@postgres:5432/fes?sslmode=disable

# --- ports exposed to host ---
#  query-api REST localhost:18080 · gRPC 19090 · ingest gRPC 19091 · dashboard 18501
#  redpanda 19092 · redis 16379 · postgres 15432
