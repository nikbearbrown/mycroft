{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mycroft-finance-investigator-evaluation-cases.schema.json",
  "title": "Finance Investigator Evaluation Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "cases"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "description": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "operation", "expected"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "stage": {"enum": ["validation", "investigation", "review"]},
          "operation": {
            "enum": [
              "baseline",
              "ledger_mismatch",
              "unmapped_account",
              "customer_revenue_mismatch",
              "headcount_payroll_mismatch",
              "step_limit",
              "agent_self_approval"
            ]
          },
          "expected": {"type": "object", "minProperties": 1}
        }
      }
    }
  }
}
