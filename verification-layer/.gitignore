# Scoped to verification-layer/ — this subsystem keeps its own ignore rules so
# nothing it needs has to be added to the repo root .gitignore.
# (The root already covers .env, __pycache__/ and *.pyc repo-wide.)

*/__pycache__
__pycache__/
*.pyc
.env
/.claude

# Runtime data — never commit the DB or persisted run history.
# The run store is machine-local; runs are reproduced by replay, not by commit.
web/data/*.db
web/data/*.json
web/data/*.json.migrated

# Local-only bulk that must never enter version control
/env
/openclaw
/youtube
/context
/docs
/divij
# Accidental pip install artefacts (e.g. a file literally named "=2.8.0")
=*
