{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mycroft-finance-investigator-scenario-plan.schema.json",
  "title": "Finance Investigator Scenario Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "classification", "baseline_run_id", "scenarios"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "title": {"type": "string", "minLength": 1},
    "classification": {"const": "SYNTHETIC_EXERCISE_ASSUMPTIONS"},
    "baseline_run_id": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose", "assumptions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "assumptions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category", "method", "value", "reasoning", "source"],
              "properties": {
                "category": {"enum": ["revenue", "cogs", "payroll", "opex"]},
                "method": {"enum": ["AMOUNT", "PERCENT_OF_ACTUAL"]},
                "value": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
                "reasoning": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
